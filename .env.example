# Base URL of the ClimbSpot API (no trailing slash)
VITE_API_URL=http://localhost:3000

# Supabase project signing Visitors in (ADR 0009): Project URL and publishable key
# (Project Settings → API keys). Without both, signing in is off.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Where Visitors who lost their authenticator app write to; until set, they are told to contact the team.
# VITE_SUPPORT_EMAIL=
